# Vercel AI Gateway: Jev (typesafe-ai/jev) + the answer models (Mistral, Claude…)
AI_GATEWAY_API_KEY=

# Optional
LEGIBLE_ANSWER_MODEL=mistral/mistral-large-3      # default model that writes answers and rewrites
LEGIBLE_FALLBACK_MODEL=mistral/mistral-small      # last resort when Jev stays unsure after a reversed second pass
MISTRAL_API_KEY=                                  # only for OCR of scanned PDFs
JUDILIBRE_KEY_ID=                                 # PISTE key, to fetch decisions not bundled in data/decisions
JUDILIBRE_ENV=sandbox
